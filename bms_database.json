    {
      "id": "ecoflow",
      "name": "EcoFlow",
      "aliases": [],
      "match_rules": [
        {
          "type": "mfg_id",
          "value": 46517
        },
        {
          "type": "name_prefix",
          "values": [
            "EF-",
            "R33",
            "R34",
            "R35"
          ]
        }
      ],
      "auth": {
        "type": "varies",
        "encrypt_types": {
          "0": {
            "name": "None",
            "severity": "critical",
            "detail": "No encryption \u2014 all data readable, commands accepted"
          },
          "1": {
            "name": "AES-CBC",
            "severity": "high",
            "detail": "Key derived from serial number (printed on device label) via MD5"
          },
          "7": {
            "name": "ECDH + AES",
            "severity": "low",
            "detail": "Full ECDH key exchange + cloud account auth required"
          }
        },
        "notes": "Encrypt type varies by model and firmware. Type 0/1 are common on older firmware."
      },
      "vulnerability": {
        "severity": "varies",
        "detail": "Depends on encrypt_type in advertisement: type 0 = fully open, type 1 = key from serial, type 7 = cloud auth required"
      },
      "serial_prefixes": {
        "R331": "Delta 2",
        "R335": "Delta 2 (alt)",
