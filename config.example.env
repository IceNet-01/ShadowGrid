# ShadowGrid Configuration
# Copy this file to config.env and fill in your values

# ── BLE Battery Addresses ──
# Your JBD/Xiaoxiang BMS battery MAC addresses (find via BLE scan)
BATT_MAC_1=AA:BB:CC:DD:EE:01
BATT_MAC_2=AA:BB:CC:DD:EE:02

# ── EcoFlow Delta 2 ──
# BLE MAC address (scan for manufacturer ID 0xB5B5)
ECOFLOW_ADDR=XX:XX:XX:XX:XX:XX
# Serial number (from EcoFlow app or BLE advertisement)
ECOFLOW_SERIAL=YOUR_ECOFLOW_SERIAL
# User ID (obtained via EcoFlow API login — see docs/ecoflow_setup.md)
ECOFLOW_USER_ID=YOUR_ECOFLOW_USER_ID

# ── WiFi (ESP32 Mobile Node) ──
WIFI_SSID=ShadowGrid
WIFI_PASS=YOUR_WIFI_PASSWORD

# ── System ──
# sudo password for bluetoothctl operations (or configure passwordless sudo for bluetoothctl)
SUDO_PASSWORD=YOUR_SUDO_PASSWORD
